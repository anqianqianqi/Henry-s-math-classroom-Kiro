# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend Email (for server-side signup emails)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=Henry's Math Classroom <noreply@yourdomain.com>

# OpenAI (for challenge image parsing, TA grading, and translation fallback)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional text model override for the built-in manga workflow.
OPENAI_TEXT_MODEL=gpt-4o-mini

# Import key for /api/studio/import (optional). Lets a trusted app upload
# .henryproblem files with one request and no sign-in: it sends the key as the
# Bearer token. The rows belong to the teacher named here, as a user id or an
# email. The key is a teacher's full power over the problem bank, so set it
# only in the site environment and in the app that needs it.
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STUDIO_IMPORT_KEY=
STUDIO_IMPORT_TEACHER=teacher@example.com

# Translation engine for user-written posts (bubble room questions and replies).
# Optional — without either of these the OpenAI key above is used instead, and
# without any key posts are simply stored untranslated.
#
# The first one set wins, so adding DEEPL_API_KEY is enough to switch over.
# A dedicated engine is preferred: it cannot decide to answer a student's
# question or "fix" their mistake the way a language model can, and it returns
# the same translation every time.
#
# DeepL free keys end in ":fx" and are routed to api-free.deepl.com automatically.
DEEPL_API_KEY=your-deepl-key-here
GOOGLE_TRANSLATE_API_KEY=your-google-cloud-translation-key-here
